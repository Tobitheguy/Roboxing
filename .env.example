# ---------------------------------------------------------------------------
# Robox — environment template
#
# Copy to .env.local and fill in. .env.local is gitignored; this file is not.
# NEVER put a real secret in this file — it is committed to a PUBLIC repo.
# ---------------------------------------------------------------------------

# --- Database (Neon) -------------------------------------------------------
# Neon console -> your project -> Connection string -> POOLED connection.
# Must be the pooled string (host contains "-pooler"), not the direct one —
# serverless functions open too many connections for the direct endpoint.
# Region: US East (audience is United States).
DATABASE_URL="postgresql://user:password@ep-xxxx-pooler.us-east-1.aws.neon.tech/robox?sslmode=require"

# --- Cloudflare Stream + R2 ------------------------------------------------
# Dashboard -> right sidebar -> Account ID.
CLOUDFLARE_ACCOUNT_ID=""

# My Profile -> API Tokens -> Create Token -> Custom token with:
#   Account | Stream            | Edit
#   Account | Workers R2 Storage| Edit
# Scope it to the Robox account only. This token can create live inputs and
# read recordings — treat it like a password.
CLOUDFLARE_API_TOKEN=""

# Stream -> any video -> the code in the playback URL:
# https://customer-<THIS>.cloudflarestream.com/...
CLOUDFLARE_STREAM_CUSTOMER_CODE=""

# R2 -> Create bucket -> name it robox-media.
R2_BUCKET="robox-media"

# R2 bucket -> Settings -> Public access (or a custom domain).
# Used as the base for team logos, robot photos, and event posters.
R2_PUBLIC_URL="https://pub-xxxxxxxx.r2.dev"

# --- Admin auth ------------------------------------------------------------
# Comma-separated list of admin email addresses.
ADMIN_EMAILS="you@example.com"

# Scrypt hash of the shared admin password. Generate with:
#   npm run hash-password
# and paste the output here. The PLAINTEXT PASSWORD NEVER GOES IN ANY FILE.
#
# Why this exists: checking an email against ADMIN_EMAILS alone is
# identification, not authentication — anyone who guesses a listed address
# would get an admin session on a public site. The password closes that.
ADMIN_PASSWORD_HASH=""

# Random 32+ byte secret used to sign the admin session cookie.
# Generate with:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=""

# --- App -------------------------------------------------------------------
# Public base URL. http://localhost:3000 locally; the Vercel URL in production.
# Used for absolute URLs in .ics calendar files and OG images.
APP_URL="http://localhost:3000"
