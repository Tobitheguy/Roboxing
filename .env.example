# ---------------------------------------------------------------------------
# Roboxing — environment template
#
# Copy to .env.local and fill in. .env.local is gitignored; this file is not.
# NEVER put a real secret in this file — it is committed to a PUBLIC repo.
# ---------------------------------------------------------------------------

# --- Database (Neon) -------------------------------------------------------
# Neon console -> your project -> Connection string -> POOLED connection.
# Must be the pooled string (host contains "-pooler"), not the direct one —
# serverless functions open too many connections for the direct endpoint.
# Region: US East (audience is United States).
DATABASE_URL="postgresql://user:password@ep-xxxx-pooler.us-east-1.aws.neon.tech/robox?sslmode=require"

# --- Cloudflare Stream + R2 ------------------------------------------------
# Dashboard -> right sidebar -> Account ID.
CLOUDFLARE_ACCOUNT_ID=""

# My Profile -> API Tokens -> Create Token -> Custom token with:
#   Account | Stream            | Edit
#   Account | Workers R2 Storage| Edit
# Scope it to the Roboxing account only. This token can create live inputs and
# read recordings — treat it like a password.
CLOUDFLARE_API_TOKEN=""

# Stream -> any video -> the code in the playback URL:
# https://customer-<THIS>.cloudflarestream.com/...
CLOUDFLARE_STREAM_CUSTOMER_CODE=""

# R2 -> Create bucket -> name it roboxing-media.
R2_BUCKET="roboxing-media"

# R2 bucket -> Settings -> Public access (or a custom domain).
# Used as the base for team logos, robot photos, and event posters.
R2_PUBLIC_URL="https://pub-xxxxxxxx.r2.dev"

# --- Admin auth ------------------------------------------------------------
# Comma-separated list of admin email addresses.
ADMIN_EMAILS="you@example.com"

# Scrypt hash of the shared admin password. Generate with:
#   npm run hash-password
# and paste the output here. The PLAINTEXT PASSWORD NEVER GOES IN ANY FILE.
#
# Why this exists: checking an email against ADMIN_EMAILS alone is
# identification, not authentication — anyone who guesses a listed address
# would get an admin session on a public site. The password closes that.
ADMIN_PASSWORD_HASH=""

# Random 32+ byte secret used to sign the admin session cookie.
# Generate with:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=""

# --- Clerk (authentication) ------------------------------------------------
# Provisioned automatically by the Vercel Marketplace integration:
#   vercel integration add clerk
# Nothing to fill in by hand.
#   CLERK_SECRET_KEY
#   NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY

# --- Stripe (subscriptions) ------------------------------------------------
# Dashboard -> Developers -> API keys. Test keys (sk_test_...) work fully
# before the account is verified, so the whole flow can be built and tested
# while business verification is still pending.
STRIPE_SECRET_KEY=""

# The recurring price for the $9.99/month plan.
# Create it once with:  npm run stripe:setup
STRIPE_PRICE_ID=""

# Dashboard -> Developers -> Webhooks -> add endpoint
#   URL:    https://<your-domain>/api/stripe/webhook
#   Events: checkout.session.completed, customer.subscription.*, invoice.paid,
#           invoice.payment_failed
# Then copy the signing secret (whsec_...).
#
# WITHOUT THIS the webhook rejects everything, and nobody who pays gets access.
# It is also what stops the endpoint being a public form for granting yourself
# a subscription.
STRIPE_WEBHOOK_SECRET=""

# --- App -------------------------------------------------------------------
# Public base URL. http://localhost:3000 locally; the Vercel URL in production.
# Used for absolute URLs in .ics calendar files and OG images.
APP_URL="http://localhost:3000"

# --- Two-factor authentication -------------------------------------------
# Set to "true" ONLY once Clerk's authenticator-app strategy is enabled
# (Clerk dashboard -> Configure -> Multi-factor). That strategy is gated
# behind Clerk's paid plan.
#
# Turning this on while Clerk cannot deliver TOTP locks out every account,
# including yours: the gate sends everyone to the enrolment screen and the
# enrolment screen cannot enrol anyone. Every screen in the flow is already
# built — this is the only switch.
REQUIRE_TWO_FACTOR=false

# --- Stripe prices -------------------------------------------------------
# One per billing interval. STRIPE_PRICE_ID_MONTHLY falls back to the older
# single-plan STRIPE_PRICE_ID; the yearly one deliberately does NOT, because
# that variable holds a MONTHLY price and using it would sell a year of
# access for the price of a month.
STRIPE_PRICE_ID_MONTHLY=price_...
STRIPE_PRICE_ID_YEARLY=price_...
