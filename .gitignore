# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files — everything ignored except the documented template
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# agent tooling — vendor skills are installed, not authored here.
# AGENTS.md, CLAUDE.md, DECISIONS.md and STATUS.md are the parts worth committing.
/.claude/
/.agents/

# ...except skills we wrote ourselves. `roboxing-social` is the design system
# written down — token rules, card formats, credit obligations, caption voice.
# That is documentation the next person needs whether or not they use an agent,
# and it has to sit in .claude/skills to be discovered at all.
!/.claude/skills/roboxing-social/

# working material: design references, screenshots and raw logo/photo sources.
# Anything the site actually serves lives in /public.
/Logos/
/League Logos/
/Login pages/
/Page inspiration/
/Robots/
/*.png
/*.jpg
/*.jpeg
/*.avif

# working material for a design handoff: screenshots and copied assets.
/design-handoff/

# Design handoffs from Claude Design: prototypes, vendor bundles and reference
# CSS. tokens.css is COPIED into src/app/globals.css rather than imported from
# here, so nothing in the build depends on this folder — and its vendored
# support.js trips eslint on rules that do not apply to our code.
/design_handoff_dir03/
