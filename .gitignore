# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files — everything ignored except the documented template
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# agent tooling — vendor skills are installed, not authored here.
# AGENTS.md, CLAUDE.md, DECISIONS.md and STATUS.md are the parts worth committing.
/.claude/
/.agents/

# working material: design references, screenshots and raw logo/photo sources.
# Anything the site actually serves lives in /public.
/Logos/
/League Logos/
/Login pages/
/Page inspiration/
/Robots/
/*.png
/*.jpg
/*.jpeg
/*.avif
